; SvZ Enhanced 120 Hz probe: a tiny Android app that runs the game's frame-pacing code
; (godot/src/Engine/Core/FramePacing*.cs) without any game files. Built by .github/workflows/probe-apk.yml.
config_version=5

[application]
config/name="SvZ 120Hz Probe"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[dotnet]
project/assembly_name="SvzProbe"

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
