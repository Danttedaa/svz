# local tool environments (recreated by `nix develop`)
.nixenv/
.venv/
# extracted/decompiled original game and build outputs
work/
build/
# converted game data (recreated by tools/build.sh)
godot/data/
godot/tex/
godot/audio/
godot/video/
godot/.godot/
godot/core.*
# signing key: back it up, never publish it
keys/
*.apk
*.idsig
__pycache__/
# decompiled Glu / Unity code: recreated from your own APK by tools/prepare_sources.sh (never publish)
godot/src/Game/
godot/src/UnityEngine/
godot/src/Engine/Stubs.g.cs
godot/icon.png
godot/src/Engine/Stubs.g.cs.uid
original/
godot/video/
# test build outputs
tests/**/bin/
tests/**/obj/
tests/godot-runtime/.godot/
tests/godot-runtime/.nuget/
tests/godot-runtime/nuget.config
# probe app build outputs
tools/probe/.godot/
tools/probe/bin/
tools/probe/obj/
tools/probe/nuget.config
# binary patch tooling
tools/binpatch/.cecil/
tools/binpatch/**/bin/
tools/binpatch/**/obj/
tests/binpatch/**/bin/
tests/binpatch/**/obj/
