<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- same as the port (godot/SvZPort.csproj): Godot 4.7 Android exports need net9.0 -->
    <!-- keep this a literal value: the Godot editor rewrites anything else to its default (net8.0) -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../godot/src/Engine/Core/FramePacing.cs" Link="FramePacing.cs" />
    <Compile Include="../../godot/src/Engine/Core/FramePacingPolicy.cs" Link="FramePacingPolicy.cs" />
  </ItemGroup>
</Project>
